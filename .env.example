# VANTA EDGE — example environment. Placeholder values only; never commit real credentials.
# Copy to apps/web/.env.local (web) or set in Vercel/EAS. .env* files are git-ignored.

# --- Web, public (bundled into the browser; safe because RLS protects data) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# --- Web, server-only (never prefix with NEXT_PUBLIC_, never use in Expo) ---
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# demo | supabase  (supabase = read canonical games from the database)
SPORTS_DATA_PROVIDER=demo
SPORTS_DATA_API_KEY=
ODDS_API_KEY=
# Keep false until a model passes the promotion gate AND is approved in model_versions.
PREDICTIONS_ENABLED=false

# --- Mobile (Expo, public) ---
EXPO_PUBLIC_API_BASE_URL=https://your-preview-url.vercel.app
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
