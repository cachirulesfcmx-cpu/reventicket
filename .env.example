# ============================================
# COPIA ESTE ARCHIVO A .env Y LLENA LOS VALORES
# Nunca subas el archivo .env a GitHub
# ============================================

# ── Base de datos ──────────────────────────────────────────────────────────────
# Obtén la URL en: Supabase > Settings > Database > Connection string (Transaction mode)
DATABASE_URL=postgresql://postgres.XXXXXXXX:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Seguridad ──────────────────────────────────────────────────────────────────
# Genera uno en: https://generate-secret.vercel.app/64
SESSION_SECRET=pega-aqui-un-string-aleatorio-muy-largo-min-32-chars

# ── Entorno ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# URL pública del frontend (necesario para CORS en producción)
FRONTEND_URL=https://tu-dominio.com

# ── WhatsApp Bot ───────────────────────────────────────────────────────────────
# Pon "true" cuando conectes tu teléfono vía código QR en el panel admin
WHATSAPP_ENABLED=false

# Número WhatsApp del admin para recibir alertas de ventas (formato: 521XXXXXXXXXX)
ADMIN_WHATSAPP_PHONE=

# ── Web Push Notifications ─────────────────────────────────────────────────────
# Genera las claves VAPID UNA SOLA VEZ con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@tu-dominio.com

# ── Analytics & Ads (opcional) ────────────────────────────────────────────────
VITE_GA4_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXX
VITE_META_PIXEL_ID=XXXXXXXXXXXXXXX

# ── JWT (opcional, se deriva de SESSION_SECRET si no se configura) ─────────────
JWT_SECRET=

# ── Trabajos automáticos ───────────────────────────────────────────────────────
JOBS_ENABLED=true

# ── Funciones adicionales ──────────────────────────────────────────────────────
WALLET_ENABLED=true
ANALYTICS_ENABLED=true
