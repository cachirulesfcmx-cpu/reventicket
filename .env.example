# Web (public browser variables only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only: never expose this in NEXT_PUBLIC_* or mobile bundles
SUPABASE_SERVICE_ROLE_KEY=
# Optional sports data providers; app runs in demo mode without these
SPORTS_DATA_PROVIDER=demo
SPORTS_DATA_API_KEY=
ODDS_API_KEY=
# Set true only after the production dataset and models pass validation
PREDICTIONS_ENABLED=false
