# Client-side (public) values only. NEVER put secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable/anon key (safe for clients; RLS protects data).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_PRIVACY_NOTICE_VERSION=borrador-2026-10
EXPO_PUBLIC_PRIVACY_NOTICE_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Server-side secrets live ONLY in Supabase Edge Function secrets (see docs/DEPLOYMENT.md):
# AI_PROVIDER, AI_API_KEY, AI_MODEL, AI_BASE_URL, AI_TIMEOUT_MS, AI_PRICE_INPUT_PER_MTOK,
# AI_PRICE_OUTPUT_PER_MTOK, AI_DAILY_BUDGET_USD, AI_ALERT_THRESHOLD_USD, ALERT_WEBHOOK_URL,
# APP_ALLOWED_ORIGINS, WORKER_SECRET
