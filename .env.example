# ============================================
# COPIA ESTE ARCHIVO A .env Y LLENA LOS VALORES
# Nunca subas el archivo .env a GitHub
# ============================================

# Base de datos (lo consigues en Supabase > Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres.XXXXXXXX:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Sesiones (genera uno en: https://generate-secret.vercel.app/64)
SESSION_SECRET=pega-aqui-un-string-aleatorio-muy-largo

# Entorno
NODE_ENV=production
PORT=5000

# WhatsApp Bot (pon "true" cuando tengas listo el teléfono de negocio)
WHATSAPP_ENABLED=false

# Trabajos automáticos (recordatorios, expiración de reservas)
JOBS_ENABLED=true

# Funciones adicionales
WALLET_ENABLED=true
ANALYTICS_ENABLED=true
