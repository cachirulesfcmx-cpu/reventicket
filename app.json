{
  "expo": {
    "name": "StudIA",
    "slug": "studia",
    "scheme": "studia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mx.studia.app",
      "infoPlist": {
        "NSCameraUsageDescription": "StudIA usa la cámara solo cuando eliges fotografiar tus apuntes.",
        "NSPhotoLibraryUsageDescription": "StudIA accede únicamente a las imágenes que eliges para estudiar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "mx.studia.app",
      "edgeToEdgeEnabled": true,
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "StudIA",
      "shortName": "StudIA",
      "lang": "es-MX",
      "themeColor": "#08090D",
      "backgroundColor": "#08090D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "StudIA usa la cámara solo cuando eliges fotografiar tus apuntes.",
          "photosPermission": "StudIA accede únicamente a las imágenes que eliges para estudiar.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
