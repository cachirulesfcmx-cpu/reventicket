{
  "name": "studia",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --runInBand",
    "test:sql": "bash supabase/tests/run-local.sh",
    "test:e2e": "node e2e/onboarding.e2e.mjs",
    "build:web": "expo export --platform web",
    "doctor": "expo-doctor",
    "eas:configure": "eas build:configure",
    "audit:gate": "node scripts/audit-gate.mjs",
    "eval:model": "node evals/run-model-evals.mjs",
    "test:rollback": "bash supabase/tests/rollback.test.sh",
    "test:perf": "bash supabase/tests/perf.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "^58.0.20",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "^3.10.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
