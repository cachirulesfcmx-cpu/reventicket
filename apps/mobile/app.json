{
  "expo": {
    "name": "VANTA EDGE",
    "slug": "vanta-edge",
    "scheme": "vantaedge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router"
    ],
    "ios": {
